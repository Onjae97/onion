# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/

# 비밀 정보
.env

# 엑셀이 열려 있을 때 생기는 임시 파일
~$*

# excel-merger 입력/결과물 (실제 업무 데이터가 올라가지 않도록)
excel-merger/input/*
!excel-merger/input/.gitkeep
excel-merger/output/

# qa-automation 실제 Spec과 생성물 (회사 문서가 올라가지 않도록)
qa-automation/tc-generation/specs/*
!qa-automation/tc-generation/specs/.gitkeep
qa-automation/tc-generation/output/

# OS
.DS_Store
Thumbs.db
